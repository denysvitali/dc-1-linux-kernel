		efuse: efuse@11c10000 {
			compatible = "mediatek,mt6789-efuse", "mediatek,efuse";
			reg = <0 0x11c10000 0 0x1000>;
			#address-cells = <1>;
			#size-cells = <1>;

			lvts_efuse_data1: lvts1-calib {
				reg = <0x1b4 0x2c>;
			};

			lvts_efuse_data2: lvts2-calib {
				reg = <0x2f8 0x8>;
			};
		};

		lvts_ap: thermal-sensor@1100b000 {
			compatible = "mediatek,mt6789-lvts-ap";
			reg = <0 0x1100b000 0 0xc00>;
			interrupts = <GIC_SPI 201 IRQ_TYPE_LEVEL_HIGH &ppi_cluster0>;
			clocks = <&infracfg_ao CLK_IFRAO_THERM>;
			resets = <&infracfg_ao MT6789_INFRA_RST0_LVTS_AP_SWRST>;

			nvmem-cells = <&lvts_efuse_data1 &lvts_efuse_data2>;
			nvmem-cell-names = "lvts-calib-data-1", "lvts-calib-data-2";

			#thermal-sensor-cells = <1>;
		};

		thermal_zones: thermal-zones {
			gpu0-thermal {
				polling-delay = <1000>;
				polling-delay-passive = <250>;
				thermal-sensors = <&lvts_ap MT6789_AP_GPU0>;

				trips {
					gpu0_alert0: trip-alert0 {
						temperature = <85000>;
						hysteresis = <2000>;
						type = "passive";
					};

					gpu0_alert1: trip-alert1 {
						temperature = <95000>;
						hysteresis = <2000>;
						type = "hot";
					};

					gpu0_crit: trip-crit {
						temperature = <100000>;
						hysteresis = <0>;
						type = "critical";
					};
				};

				cooling-maps {
					map0 {
						trip = <&gpu0_alert0>;
						cooling-device = <&gpu THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
					};
				};
			};

			gpu1-thermal {
				polling-delay = <1000>;
				polling-delay-passive = <250>;
