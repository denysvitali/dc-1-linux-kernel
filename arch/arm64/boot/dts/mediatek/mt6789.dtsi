#include <dt-bindings/interrupt-controller/arm-gic.h>
#include <dt-bindings/interrupt-controller/irq.h>
#include <dt-bindings/phy/phy.h>

#include <dt-bindings/clock/mediatek,mt6789-clk.h>
#include <dt-bindings/power/mediatek,mt6789-power.h>
#include <dt-bindings/reset/mediatek,mt6789-resets.h>
#include <dt-bindings/gce/mediatek,mt6789-gce.h>
#include <dt-bindings/memory/mediatek,mt6789-memory-port.h>
#include <dt-bindings/thermal/thermal.h>
#include <dt-bindings/thermal/mediatek,lvts-thermal.h>

/ {
	compatible = "mediatek,mt6789";
	interrupt-parent = <&gic>;
	#address-cells = <2>;
	#size-cells = <2>;

	aliases {
		i2c0 = &i2c0;
		i2c1 = &i2c1;
		i2c2 = &i2c2;
		i2c3 = &i2c3;
		i2c4 = &i2c4;
		i2c5 = &i2c5;
		i2c6 = &i2c6;
		i2c7 = &i2c7;
		i2c8 = &i2c8;
		i2c9 = &i2c9;
	};

	cpus {
		#address-cells = <1>;
		#size-cells = <0>;

		cpu0: cpu@0 {
			device_type = "cpu";
			compatible = "arm,cortex-a55";
			reg = <0x000>;
			enable-method = "psci";
			clock-frequency = <2000000000>;
			capacity-dmips-mhz = <578>;
			performance-domains = <&performance 0>;
			i-cache-size = <32768>;
			i-cache-line-size = <64>;
			i-cache-sets = <128>;
			d-cache-size = <32768>;
			d-cache-line-size = <64>;
			d-cache-sets = <128>;
			next-level-cache = <&l2_0>;
			#cooling-cells = <2>;
		};

		cpu1: cpu@100 {
			device_type = "cpu";
			compatible = "arm,cortex-a55";
			reg = <0x100>;
			enable-method = "psci";
			clock-frequency = <2000000000>;
			capacity-dmips-mhz = <578>;
			performance-domains = <&performance 0>;
			i-cache-size = <32768>;
			i-cache-line-size = <64>;
			i-cache-sets = <128>;
			d-cache-size = <32768>;
			d-cache-line-size = <64>;
			d-cache-sets = <128>;
			next-level-cache = <&l2_0>;
			#cooling-cells = <2>;
		};

		cpu2: cpu@200 {
			device_type = "cpu";
			compatible = "arm,cortex-a55";
			reg = <0x200>;
			enable-method = "psci";
			clock-frequency = <2000000000>;
			capacity-dmips-mhz = <578>;
			performance-domains = <&performance 0>;
			i-cache-size = <32768>;
			i-cache-line-size = <64>;
			i-cache-sets = <128>;
			d-cache-size = <32768>;
			d-cache-line-size = <64>;
			d-cache-sets = <128>;
			next-level-cache = <&l2_0>;
			#cooling-cells = <2>;
		};

		cpu3: cpu@300 {
			device_type = "cpu";
			compatible = "arm,cortex-a55";
			reg = <0x300>;
			enable-method = "psci";
			clock-frequency = <2000000000>;
			capacity-dmips-mhz = <578>;
			performance-domains = <&performance 0>;
			i-cache-size = <32768>;
			i-cache-line-size = <64>;
			i-cache-sets = <128>;
			d-cache-size = <32768>;
			d-cache-line-size = <64>;
			d-cache-sets = <128>;
			next-level-cache = <&l2_0>;
			#cooling-cells = <2>;
		};

		cpu4: cpu@400 {
			device_type = "cpu";
			compatible = "arm,cortex-a55";
			reg = <0x400>;
			enable-method = "psci";
			clock-frequency = <2000000000>;
			capacity-dmips-mhz = <578>;
			performance-domains = <&performance 0>;
			i-cache-size = <32768>;
			i-cache-line-size = <64>;
			i-cache-sets = <128>;
			d-cache-size = <32768>;
			d-cache-line-size = <64>;
			d-cache-sets = <128>;
			next-level-cache = <&l2_0>;
			#cooling-cells = <2>;
		};

		cpu5: cpu@500 {
			device_type = "cpu";
			compatible = "arm,cortex-a55";
			reg = <0x500>;
			enable-method = "psci";
			clock-frequency = <2000000000>;
			capacity-dmips-mhz = <578>;
			performance-domains = <&performance 0>;
			i-cache-size = <32768>;
			i-cache-line-size = <64>;
			i-cache-sets = <128>;
			d-cache-size = <32768>;
			d-cache-line-size = <64>;
			d-cache-sets = <128>;
			next-level-cache = <&l2_0>;
			#cooling-cells = <2>;
		};

		cpu6: cpu@600 {
			device_type = "cpu";
			compatible = "arm,cortex-a76";
			reg = <0x600>;
			enable-method = "psci";
			clock-frequency = <2200000000>;
			capacity-dmips-mhz = <1024>;
			performance-domains = <&performance 1>;
			i-cache-size = <65536>;
			i-cache-line-size = <64>;
			i-cache-sets = <256>;
			d-cache-size = <65536>;
			d-cache-line-size = <64>;
			d-cache-sets = <256>;
			next-level-cache = <&l2_1>;
			#cooling-cells = <2>;
		};

		cpu7: cpu@700 {
			device_type = "cpu";
			compatible = "arm,cortex-a76";
			reg = <0x700>;
			enable-method = "psci";
			clock-frequency = <2200000000>;
			capacity-dmips-mhz = <1024>;
			performance-domains = <&performance 1>;
			i-cache-size = <65536>;
			i-cache-line-size = <64>;
			i-cache-sets = <256>;
			d-cache-size = <65536>;
			d-cache-line-size = <64>;
			d-cache-sets = <256>;
			next-level-cache = <&l2_1>;
			#cooling-cells = <2>;
		};

		cpu-map {
			cluster0 {
				core0 {
					cpu = <&cpu0>;
				};

				core1 {
					cpu = <&cpu1>;
				};

				core2 {
					cpu = <&cpu2>;
				};

				core3 {
					cpu = <&cpu3>;
				};
				core4 {
					cpu = <&cpu4>;
				};

				core5 {
					cpu = <&cpu5>;
				};
			};

			cluster1 {
				core0 {
					cpu = <&cpu6>;
				};

				core1 {
					cpu = <&cpu7>;
				};
			};
		};

		l2_0: l2-cache0 {
			compatible = "cache";
			cache-level = <2>;
			cache-size = <131072>;
			cache-line-size = <64>;
			cache-sets = <512>;
			next-level-cache = <&l3_0>;
			cache-unified;
		};

		l2_1: l2-cache1 {
			compatible = "cache";
			cache-level = <2>;
			cache-size = <262144>;
			cache-line-size = <64>;
			cache-sets = <512>;
			next-level-cache = <&l3_0>;
			cache-unified;
		};

		l3_0: l3-cache {
			compatible = "cache";
			cache-level = <3>;
			cache-size = <1048576>;
			cache-line-size = <64>;
			cache-sets = <1024>;
			cache-unified;
		};
	};

	dsu-pmu {
		compatible = "arm,dsu-pmu";
		interrupts = <GIC_SPI 18 IRQ_TYPE_LEVEL_HIGH &ppi_cluster0>;
		cpus = <&cpu0>, <&cpu1>, <&cpu2>, <&cpu3>,
		       <&cpu4>, <&cpu5>, <&cpu6>, <&cpu7>;
	};

	clk13m: fixed-factor-clock-13m {
		compatible = "fixed-factor-clock";
		#clock-cells = <0>;
		clocks = <&clk26m>;
		clock-div = <2>;
		clock-mult = <1>;
		clock-output-names = "clk13m";
	};

	clk26m: oscillator-26m {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <26000000>;
		clock-output-names = "clk26m";
	};

	clk32k: oscillator-32k {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <32768>;
		clock-output-names = "clk32k";
	};

	gpu_opp_table: opp-table-gpu {
		compatible = "operating-points-v2";
		opp-shared;

		opp-390000000 {
			opp-hz = /bits/ 64 <390000000>;
			opp-microvolt = <675000>;
		};
		opp-467000000 {
			opp-hz = /bits/ 64 <467000000>;
			opp-microvolt = <681250>;
		};
		opp-545000000 {
			opp-hz = /bits/ 64 <545000000>;
			opp-microvolt = <687500>;
		};
		opp-622000000 {
			opp-hz = /bits/ 64 <622000000>;
			opp-microvolt = <693750>;
		};
		opp-700000000 {
			opp-hz = /bits/ 64 <700000000>;
			opp-microvolt = <700000>;
		};
		opp-711000000 {
			opp-hz = /bits/ 64 <711000000>;
			opp-microvolt = <706250>;
		};
		opp-722000000 {
			opp-hz = /bits/ 64 <722000000>;
			opp-microvolt = <712500>;
		};
		opp-733000000 {
			opp-hz = /bits/ 64 <733000000>;
			opp-microvolt = <718750>;
		};
		opp-745000000 {
			opp-hz = /bits/ 64 <745000000>;
			opp-microvolt = <725000>;
		};
		opp-756000000 {
			opp-hz = /bits/ 64 <756000000>;
			opp-microvolt = <731250>;
		};
		opp-767000000 {
			opp-hz = /bits/ 64 <767000000>;
			opp-microvolt = <737500>;
		};
		opp-778000000 {
			opp-hz = /bits/ 64 <778000000>;
			opp-microvolt = <743750>;
		};
		opp-790000000 {
			opp-hz = /bits/ 64 <790000000>;
			opp-microvolt = <750000>;
		};
		opp-812000000 {
			opp-hz = /bits/ 64 <812000000>;
			opp-microvolt = <756250>;
		};
		opp-823000000 {
			opp-hz = /bits/ 64 <823000000>;
			opp-microvolt = <762500>;
		};
		opp-835000000 {
			opp-hz = /bits/ 64 <835000000>;
			opp-microvolt = <768750>;
		};
		opp-846000000 {
			opp-hz = /bits/ 64 <846000000>;
			opp-microvolt = <775000>;
		};
		opp-857000000 {
			opp-hz = /bits/ 64 <857000000>;
			opp-microvolt = <781250>;
		};
		opp-868000000 {
			opp-hz = /bits/ 64 <868000000>;
			opp-microvolt = <787500>;
		};
		opp-880000000 {
			opp-hz = /bits/ 64 <880000000>;
			opp-microvolt = <793750>;
		};
		opp-893000000 {
			opp-hz = /bits/ 64 <893000000>;
			opp-microvolt = <800000>;
		};
		opp-907000000 {
			opp-hz = /bits/ 64 <907000000>;
			opp-microvolt = <806250>;
		};
		opp-921000000 {
			opp-hz = /bits/ 64 <921000000>;
			opp-microvolt = <812500>;
		};
		opp-935000000 {
			opp-hz = /bits/ 64 <935000000>;
			opp-microvolt = <818750>;
		};
		opp-948000000 {
			opp-hz = /bits/ 64 <948000000>;
			opp-microvolt = <825000>;
		};
		opp-962000000 {
			opp-hz = /bits/ 64 <962000000>;
			opp-microvolt = <831250>;
		};
		opp-976000000 {
			opp-hz = /bits/ 64 <976000000>;
			opp-microvolt = <843750>;
		};
		opp-990000000 {
			opp-hz = /bits/ 64 <990000000>;
			opp-microvolt = <850000>;
		};
		opp-1003000000 {
			opp-hz = /bits/ 64 <1003000000>;
			opp-microvolt = <856250>;
		};
		opp-1017000000 {
			opp-hz = /bits/ 64 <1017000000>;
			opp-microvolt = <862500>;
		};
		opp-1031000000 {
			opp-hz = /bits/ 64 <1031000000>;
			opp-microvolt = <868750>;
		};
		opp-1045000000 {
			opp-hz = /bits/ 64 <1045000000>;
			opp-microvolt = <875000>;
		};
		opp-1058000000 {
			opp-hz = /bits/ 64 <1058000000>;
			opp-microvolt = <881250>;
		};
		opp-1072000000 {
			opp-hz = /bits/ 64 <1072000000>;
			opp-microvolt = <887500>;
		};
		opp-1086000000 {
			opp-hz = /bits/ 64 <1086000000>;
			opp-microvolt = <893750>;
		};
		opp-1100000000 {
			opp-hz = /bits/ 64 <1100000000>;
			opp-microvolt = <900000>;
		};
	};

	pmu-a55 {
		compatible = "arm,cortex-a55-pmu";
		interrupt-parent = <&gic>;
		interrupts = <GIC_PPI 7 IRQ_TYPE_LEVEL_HIGH &ppi_cluster0>;
	};

	/*
	pmu-a76 {
		compatible = "arm,cortex-a76-pmu";
		interrupt-parent = <&gic>;
		interrupts = <GIC_PPI 7 IRQ_TYPE_LEVEL_HIGH &ppi_cluster1>;
	};*/

	psci {
		compatible = "arm,psci-1.0";
		method = "smc";
	};

	timer: timer {
		compatible = "arm,armv8-timer";
		interrupt-parent = <&gic>;
		interrupts = <GIC_PPI 13 IRQ_TYPE_LEVEL_HIGH &ppi_cluster0>,
		             <GIC_PPI 14 IRQ_TYPE_LEVEL_HIGH &ppi_cluster0>,
		             <GIC_PPI 11 IRQ_TYPE_LEVEL_HIGH &ppi_cluster0>,
		             <GIC_PPI 10 IRQ_TYPE_LEVEL_HIGH &ppi_cluster0>;
	};

	soc {
		#address-cells = <2>;
		#size-cells = <2>;
		compatible = "simple-bus";
		ranges;

		performance: performance-controller@11bc10 {
			compatible = "mediatek,mt6789-cpufreq-hw";
			reg = <0 0x0011bc10 0 0x120>, <0 0x0011bd30 0 0x120>;
			#performance-domain-cells = <1>;
		};

		gic: interrupt-controller@c000000 {
			compatible = "arm,gic-v3";
			#interrupt-cells = <4>;
			#redistributor-regions = <1>;
			interrupt-parent = <&gic>;
			interrupt-controller;
			reg = <0 0x0c000000 0 0x40000>,
			      <0 0x0c040000 0 0x200000>;
			interrupts = <GIC_PPI 9 IRQ_TYPE_LEVEL_HIGH &ppi_cluster0>;

			ppi-partitions {
				ppi_cluster0: interrupt-partition-0 {
					affinity = <&cpu0 &cpu1 &cpu2 &cpu3 &cpu4 &cpu5>;
				};

				ppi_cluster1: interrupt-partition-1 {
					affinity = <&cpu6 &cpu7>;
				};
			};
		};

		systimer: systimer@10017000 {
			compatible = "mediatek,mt6789-timer",
			             "mediatek,mt6765-timer";
			reg = <0 0x10017000 0 0x1000>;
			interrupts = <GIC_SPI 265 IRQ_TYPE_LEVEL_HIGH &ppi_cluster0>;
			clocks = <&clk13m>;
		};

		scpsys: syscon@10006000 {
			compatible = "mediatek,mt6789-scpsys", "syscon", "simple-mfd";
			reg = <0 0x10006000 0 0x1000>;

			/* System Power Manager */
			spm: power-controller {
				compatible = "mediatek,mt6789-power-controller";
				#address-cells = <1>;
				#size-cells = <0>;
				#power-domain-cells = <1>;

				/* power domain of the SoC */
				power-domain@MT6789_POWER_DOMAIN_AUDIO {
					reg = <MT6789_POWER_DOMAIN_AUDIO>;
					clocks = <&topckgen CLK_TOP_AUD_INTBUS_SEL>,
					         <&infracfg_ao CLK_IFRAO_AUDIO_26M_BCLK>,
					         <&infracfg_ao CLK_IFRAO_AUDIO>;
					clock-names = "audio", "audio1", "audio2";
					mediatek,infracfg = <&infracfg_ao>;
					#power-domain-cells = <0>;
				};

				power-domain@MT6789_POWER_DOMAIN_MD {
					reg = <MT6789_POWER_DOMAIN_MD>;
					mediatek,infracfg = <&infracfg_ao>;
					#address-cells = <1>;
					#size-cells = <0>;
					#power-domain-cells = <1>;
				};

				power-domain@MT6789_POWER_DOMAIN_CONN {
					reg = <MT6789_POWER_DOMAIN_CONN>;
					mediatek,infracfg = <&infracfg_ao>;
					#address-cells = <1>;
					#size-cells = <0>;
					#power-domain-cells = <1>;
				};

				mfg0: power-domain@MT6789_POWER_DOMAIN_MFG0 {
					reg = <MT6789_POWER_DOMAIN_MFG0>;
					#address-cells = <1>;
					#size-cells = <0>;
					#power-domain-cells = <1>;

					mfg1: power-domain@MT6789_POWER_DOMAIN_MFG1 {
						reg = <MT6789_POWER_DOMAIN_MFG1>;
						clocks = <&topckgen CLK_TOP_MFG_PLL_SEL>,
						         <&topckgen CLK_TOP_MFG_REF_SEL>;
						clock-names = "mfg", "alt";
						mediatek,infracfg = <&infracfg_ao>;
						#address-cells = <1>;
						#size-cells = <0>;
						#power-domain-cells = <1>;

						mfg2: power-domain@MT6789_POWER_DOMAIN_MFG2 {
							reg = <MT6789_POWER_DOMAIN_MFG2>;
							clocks = <&mfgcfg CLK_MFGCFG_BG3D>;
							clock-names = "mfg";
							#power-domain-cells = <0>;
						};

						power-domain@MT6789_POWER_DOMAIN_MFG3 {
							reg = <MT6789_POWER_DOMAIN_MFG3>;
							#power-domain-cells = <0>;
						};
					};
				};

				disp: power-domain@MT6789_POWER_DOMAIN_DISP {
					reg = <MT6789_POWER_DOMAIN_DISP>;
					clocks = <&topckgen CLK_TOP_DISP_SEL>,
					         <&mdpsys CLK_MDP_SMI0>,
					         <&mmsys CLK_MM_SMI_INFRA>,
					         <&mmsys CLK_MM_SMI_COMMON>,
					         <&mmsys CLK_MM_SMI_GALS>,
					         <&mmsys CLK_MM_SMI_IOMMU>,
					         <&topckgen CLK_TOP_MDP_SEL>;
					clock-names = "disp", "disp-0", "disp-1", "disp-2",
								  "disp-3", "disp-4", "mdp";
					mediatek,infracfg = <&infracfg_ao>;
					#address-cells = <1>;
					#size-cells = <0>;
					#power-domain-cells = <1>;

					power-domain@MT6789_POWER_DOMAIN_IPE {
						reg = <MT6789_POWER_DOMAIN_IPE>;
						clocks = <&topckgen CLK_TOP_IPE_SEL>,
						         <&ipesys CLK_IPE_SMI_SUBCOM>,
						         <&ipesys CLK_IPE_GALS>,
						         <&ipesys CLK_IPE_LARB19>,
						         <&ipesys CLK_IPE_LARB20>;
						clock-names = "ipe", "ipe-0", "ipe-1", "ipe-2",
									  "ipe-3";
						mediatek,infracfg = <&infracfg_ao>;
						#power-domain-cells = <0>;
					};

					power-domain@MT6789_POWER_DOMAIN_ISP {
						reg = <MT6789_POWER_DOMAIN_ISP>;
						clocks = <&topckgen CLK_TOP_IMG1_SEL>,
						         <&imgsys CLK_IMGSYS_GALS>,
						         <&imgsys CLK_IMGSYS_LARB9>;
						clock-names = "isp", "isp-0", "isp-1";
						mediatek,infracfg = <&infracfg_ao>;
						#power-domain-cells = <0>;
					};

					power-domain@MT6789_POWER_DOMAIN_VENC {
						reg = <MT6789_POWER_DOMAIN_VENC>;
						clocks = <&topckgen CLK_TOP_VENC_SEL>,
						         <&vencsys CLK_VEN1_CKE1_VENC>;
						clock-names = "venc", "venc-0";
						mediatek,infracfg = <&infracfg_ao>;
						#power-domain-cells = <0>;
					};

					power-domain@MT6789_POWER_DOMAIN_VDEC {
						reg = <MT6789_POWER_DOMAIN_VDEC>;
						clocks = <&topckgen CLK_TOP_VDEC_SEL>,
						         <&vdecsys CLK_VDE2_VDEC_CKEN>,
						         <&vdecsys CLK_VDE2_LARB1_CKEN>;
						clock-names = "vdec", "vdec-0", "vdec-1";
						mediatek,infracfg = <&infracfg_ao>;
						#address-cells = <1>;
						#size-cells = <0>;
						#power-domain-cells = <1>;
					};

					power-domain@MT6789_POWER_DOMAIN_CAM {
						reg = <MT6789_POWER_DOMAIN_CAM>;
						clocks = <&topckgen CLK_TOP_CAM_SEL>,
						         <&camsys CLK_CAM_M_LARB13>,
						         <&camsys CLK_CAM_M_LARB14>;
						clock-names = "cam", "cam-0", "cam-1";
						mediatek,infracfg = <&infracfg_ao>;
						#address-cells = <1>;
						#size-cells = <0>;
						#power-domain-cells = <1>;

						power-domain@MT6789_POWER_DOMAIN_CAM_RAWA {
							reg = <MT6789_POWER_DOMAIN_CAM_RAWA>;
							clocks = <&camsys_raw_a CLK_CAM_RA_LARBX>;
							clock-names = "cam_rawa-0";
							#power-domain-cells = <0>;
						};

						power-domain@MT6789_POWER_DOMAIN_CAM_RAWB {
							reg = <MT6789_POWER_DOMAIN_CAM_RAWB>;
							clocks = <&camsys_raw_b CLK_CAM_RB_LARBX>;
							clock-names = "cam_rawb-0";
							#power-domain-cells = <0>;
						};
					};
				};
			};
		};

		dvfsrc: system-controller@10012000 {
			compatible = "mediatek,mt6789-dvfsrc";
			reg = <0 0x10012000 0 0x1000>;

			regulators {
				compatible = "mediatek,mt6789-dvfsrc-regulator";

				dvfsrc_vcore: dvfsrc-vcore {
					regulator-name = "dvfsrc-vcore";
					regulator-min-microvolt = <550000>;
					regulator-max-microvolt = <725000>;
					regulator-always-on;
				};

				dvfsrc_vscp: dvfsrc-vscp {
					regulator-name = "dvfsrc-vscp";
					regulator-min-microvolt = <550000>;
					regulator-max-microvolt = <725000>;
					regulator-always-on;
				};
			};

			emi_icc: interconnect {
				compatible = "mediatek,mt6789-emi";
				#interconnect-cells = <1>;
			};
		};

		toprgu: watchdog@10007000 {
			compatible = "mediatek,mt6789-wdt",
				     "mediatek,mt6589-wdt";
			reg = <0 0x10007000 0 0x100>;

			reboot-mode {
				compatible = "syscon-reboot-mode";
				offset = <0x24>;
				mask = <0xf>;
				mode-recovery = <2>;
				mode-bootloader = <3>;
			};
		};

		mcusys: syscon@c530000 {
			compatible = "mediatek,mt6789-mcusys", "syscon";
			reg = <0 0xc530000 0 0x1000>;
			#clock-cells = <1>;
		};

		topckgen: clock-controller@10000000 {
			compatible = "mediatek,mt6789-topckgen", "syscon";
			reg = <0 0x10000000 0 0x1000>;
			#clock-cells = <1>;
		};

		infracfg_ao: syscon@10001000 {
			compatible = "mediatek,mt6789-infracfg_ao", "syscon";
			reg = <0 0x10001000 0 0x1000>;
			#clock-cells = <1>;
			#reset-cells = <1>;
