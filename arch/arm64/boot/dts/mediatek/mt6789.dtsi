			                  &larb13 &larb14 &larb16
			                  &larb17 &larb20>;
			power-domains = <&spm MT6789_POWER_DOMAIN_DISP>;
			clocks = <&mmsys CLK_MM_SMI_IOMMU>;
			clock-names = "bclk";
			#iommu-cells = <1>;
		};*/

		larb1: smi@14004000 {
			compatible = "mediatek,mt6789-smi-larb";
			mediatek,smi = <&smi_common_disp>;
			reg = <0 0x14004000 0 0x1000>;
			mediatek,larb-id = <1>;
			power-domains = <&spm MT6789_POWER_DOMAIN_DISP>;
			clocks = <&mmsys CLK_MM_SMI_INFRA>,
			         <&mmsys CLK_MM_SMI_COMMON>,
			         <&mmsys CLK_MM_SMI_GALS>,
			         <&mmsys CLK_MM_SMI_IOMMU>;
			clock-names = "apb", "smi", "gals0", "gals1";
		};

		larb2: smi@1f002000 {
			compatible = "mediatek,mt6789-smi-larb";
			mediatek,smi = <&smi_common_disp>;
			reg = <0 0x1f002000 0 0x1000>;
			mediatek,larb-id = <2>;
			power-domains = <&spm MT6789_POWER_DOMAIN_DISP>;
			clocks = <&mdpsys CLK_MDP_SMI0>,
			         <&mdpsys CLK_MDP_SMI0>;
			clock-names = "apb","smi";
		};

		larb4: smi@1602e000 {
			compatible = "mediatek,mt6789-smi-larb";
			mediatek,smi = <&smi_common_disp>;
			reg = <0 0x1602e000 0 0x1000>;
			mediatek,larb-id = <4>;
			power-domains = <&spm MT6789_POWER_DOMAIN_VDEC>;
			clocks = <&vdecsys CLK_VDE2_LARB1_CKEN>,
			         <&vdecsys CLK_VDE2_VDEC_CKEN>;
			clock-names = "apb", "smi";
		};

		larb7: smi@17010000 {
			compatible = "mediatek,mt6789-smi-larb";
			reg = <0 0x17010000 0 0x1000>;
			mediatek,smi = <&smi_common_disp>;
			mediatek,larb-id = <7>;
			power-domains = <&spm MT6789_POWER_DOMAIN_VENC>;
			clocks = <&vencsys CLK_VEN1_CKE0_LARB>,
			         <&vencsys CLK_VEN1_CKE2_JPGENC>;
			clock-names = "apb", "smi";
		};

		larb9: smi@1502e000 {
			compatible = "mediatek,mt6789-smi-larb";
			mediatek,smi = <&smi_sub_comm_img0>;
			reg = <0 0x1502e000 0 0x1000>;
			mediatek,larb-id = <9>;
			power-domains = <&spm MT6789_POWER_DOMAIN_ISP>;
			clocks = <&imgsys CLK_IMGSYS_LARB9>,
			         <&imgsys CLK_IMGSYS_LARB9>;
			clock-names = "apb", "smi";
		};

		larb20: smi@1b00f000 {
			compatible = "mediatek,mt6789-smi-larb";
			reg = <0 0x1b00f000 0 0x1000>;
			mediatek,smi = <&smi_sub_comm_ipe>;
			mediatek,larb-id = <20>;
			power-domains = <&spm MT6789_POWER_DOMAIN_IPE>;
			clocks = <&ipesys CLK_IPE_LARB20>,
			         <&ipesys CLK_IPE_LARB20>;
			clock-names = "apb", "smi";
		};

		larb13: smi@1a001000 {
			compatible = "mediatek,mt6789-smi-larb";
			mediatek,smi = <&smi_sub_comm_cam0>;
			reg = <0 0x1a001000 0 0x1000>;
			mediatek,larb-id = <13>;
			power-domains = <&spm MT6789_POWER_DOMAIN_CAM>;
			clocks = <&camsys CLK_CAM_M_LARB13>,
			         <&camsys CLK_CAM_M_LARB13>;
			clock-names = "apb", "smi";
		};

		larb14: smi@1a002000 {
			compatible = "mediatek,mt6789-smi-larb";
			mediatek,smi = <&smi_sub_comm_cam1>;
			reg = <0 0x1a002000 0 0x1000>;
			mediatek,larb-id = <14>;
			power-domains = <&spm MT6789_POWER_DOMAIN_CAM>;
			clocks = <&camsys CLK_CAM_M_LARB14>,
			         <&camsys CLK_CAM_M_LARB14>;
			clock-names = "apb", "smi";
		};

		larb16: smi@1a00f000 {
			compatible = "mediatek,mt6789-smi-larb";
			mediatek,smi = <&smi_sub_comm_cam1>;
			reg = <0 0x1a00f000 0 0x1000>;
			mediatek,larb-id = <16>;
			power-domains = <&spm MT6789_POWER_DOMAIN_CAM_RAWA>;
			clocks = <&camsys_raw_a CLK_CAM_RA_LARBX>,
			         <&camsys_raw_a CLK_CAM_RA_CAM>;
			clock-names = "apb", "smi";
		};

		larb17: smi@1a010000 {
			compatible = "mediatek,mt6789-smi-larb";
			mediatek,smi = <&smi_sub_comm_cam0>;
			reg = <0 0x1a010000 0 0x1000>;
			mediatek,larb-id = <17>;
			power-domains = <&spm MT6789_POWER_DOMAIN_CAM_RAWB>;
			clocks = <&camsys_raw_b CLK_CAM_RB_LARBX>,
			         <&camsys_raw_b CLK_CAM_RB_CAM>;
			clock-names = "apb", "smi";
		};

		gpu: gpu@13000000 {
			compatible = "mediatek,mt6789-mali", "arm,mali-valhall-jm";
			reg = <0 0x13000000 0 0x4000>;

			clocks = <&mfgcfg CLK_MFGCFG_BG3D>;
			interrupts = <GIC_SPI 398 IRQ_TYPE_LEVEL_HIGH &ppi_cluster0>,
			             <GIC_SPI 397 IRQ_TYPE_LEVEL_HIGH &ppi_cluster0>,
			             <GIC_SPI 396 IRQ_TYPE_LEVEL_HIGH &ppi_cluster0>;
			interrupt-names = "job", "mmu", "gpu";
			operating-points-v2 = <&gpu_opp_table>;
			power-domains = <&spm MT6789_POWER_DOMAIN_MFG2>,
			                <&spm MT6789_POWER_DOMAIN_MFG3>;
			power-domain-names = "core0", "core1";
			#cooling-cells = <2>;
			status = "disabled";
		};

		mipi_tx0: dsi-phy@11f60000 {
			compatible = "mediatek,mt6789-mipi-tx";
			reg = <0 0x11f60000 0 0x1000>;
			clocks = <&clk26m>;
			#clock-cells = <0>;
			#phy-cells = <0>;
			clock-output-names = "mipi_tx0_pll";
		};

		dsi0: dsi@14013000 {
			compatible = "mediatek,mt6789-dsi";
			reg = <0 0x14013000 0 0x1000>;
			interrupts = <GIC_SPI 301 IRQ_TYPE_LEVEL_HIGH &ppi_cluster0>;
			power-domains = <&spm MT6789_POWER_DOMAIN_DISP>;
			clocks = <&mmsys CLK_MM_DSI0>,
			         <&mmsys CLK_MM_DSI0_DSI_CK_DOMAIN>,
			         <&mipi_tx0>;
			clock-names = "engine", "digital", "hs";
			// TODO: Add support for resets in mmsys driver
			//resets = <&mmsys MT6789_MMSYS_SW0_RST_DSI>;
			phys = <&mipi_tx0>;
			phy-names = "dphy";

			ports {
				#address-cells = <1>;
				#size-cells = <0>;

				port@0 {
					reg = <0>;
					dsi0_in: endpoint {
						remote-endpoint = <&dsc0_out>;
					};
				};

				port@1 {
					reg = <1>;
					dsi0_out: endpoint { };
				};
			};
		};

		dsc0: dsc@14012000 {
			compatible = "mediatek,mt6789-disp-dsc";
			reg = <0 0x14012000 0 0x1000>;
			interrupts = <GIC_SPI 300 IRQ_TYPE_LEVEL_HIGH &ppi_cluster0>;
			power-domains = <&spm MT6789_POWER_DOMAIN_DISP>;
			clocks = <&mmsys CLK_MM_DISP_DSC_WRAP0>;
			mediatek,gce-client-reg = <&gce0 SUBSYS_1401XXXX 0x2000 0x1000>;

			ports {
				#address-cells = <1>;
				#size-cells = <0>;

				port@0 {
					reg = <0>;
					dsc0_in: endpoint {
						remote-endpoint = <&dither0_out>;
					};
				};

				port@1 {
					reg = <1>;
					dsc0_out: endpoint {
						remote-endpoint = <&dsi0_in>;
					};
				};
			};
		};

		ovl0: ovl@14005000 {
			compatible = "mediatek,mt6789-disp-ovl", "mediatek,mt8192-disp-ovl";
			reg = <0 0x14005000 0 0x1000>;
			interrupts = <GIC_SPI 287 IRQ_TYPE_LEVEL_HIGH &ppi_cluster0>;
			power-domains = <&spm MT6789_POWER_DOMAIN_DISP>;
			clocks = <&mmsys CLK_MM_DISP_OVL0>;
			mediatek,gce-client-reg = <&gce0 SUBSYS_1400XXXX 0x5000 0x1000>;
			/*iommus = <&iommu0 M4U_PORT_L0_OVL_RDMA0>,
			         <&iommu0 M4U_PORT_L0_OVL_RDMA0_HDR>;*/

			ports {
				#address-cells = <1>;
				#size-cells = <0>;

				port@0 {
					reg = <0>;
					ovl0_in: endpoint { };
				};

				port@1 {
					reg = <1>;
					ovl0_out: endpoint {
						remote-endpoint = <&rdma0_in>;
					};
				};
			};
		};

		ovl_2l0: ovl@14006000 {
			compatible = "mediatek,mt6789-disp-ovl", "mediatek,mt8192-disp-ovl-2l";
			reg = <0 0x14006000 0 0x1000>;
			interrupts = <GIC_SPI 288 IRQ_TYPE_LEVEL_HIGH &ppi_cluster0>;
			power-domains = <&spm MT6789_POWER_DOMAIN_DISP>;
			clocks = <&mmsys CLK_MM_DISP_OVL0_2L>;
			/*iommus = <&iommu0 M4U_PORT_L1_OVL_2L_RDMA0>,
			         <&iommu0 M4U_PORT_L1_OVL_2L_RDMA0_HDR>;*/
			mediatek,gce-client-reg = <&gce0 SUBSYS_1400XXXX 0x6000 0x1000>;
		};

		rdma0: rdma@14007000 {
			compatible = "mediatek,mt6789-disp-rdma";
			reg = <0 0x14007000 0 0x1000>;
			interrupts = <GIC_SPI 289 IRQ_TYPE_LEVEL_HIGH &ppi_cluster0>;
			power-domains = <&spm MT6789_POWER_DOMAIN_DISP>;
			clocks = <&mmsys CLK_MM_DISP_RDMA0>;
			mediatek,rdma-fifo-size = <48992>;
			mediatek,gce-client-reg = <&gce0 SUBSYS_1400XXXX 0x7000 0x1000>;
			/*iommus = <&iommu0 M4U_PORT_L1_DISP_RDMA0>;*/

			ports {
				#address-cells = <1>;
				#size-cells = <0>;

				port@0 {
					reg = <0>;
					rdma0_in: endpoint {
						remote-endpoint = <&ovl0_out>;
					};
				};

				port@1 {
					reg = <1>;
					rdma0_out: endpoint {
						remote-endpoint = <&color0_in>;
					};
				};
			};
		};

		color0: color@14009000 {
			compatible = "mediatek,mt6789-disp-color", "mediatek,mt8173-disp-color";
			reg = <0 0x14009000 0 0x1000>;
			interrupts = <GIC_SPI 291 IRQ_TYPE_LEVEL_HIGH &ppi_cluster0>;
			power-domains = <&spm MT6789_POWER_DOMAIN_DISP>;
			clocks = <&mmsys CLK_MM_DISP_COLOR0>;
			mediatek,gce-client-reg = <&gce0 SUBSYS_1400XXXX 0x9000 0x1000>;

			ports {
				#address-cells = <1>;
				#size-cells = <0>;

				port@0 {
					reg = <0>;
					color0_in: endpoint {
						remote-endpoint = <&rdma0_out>;
					};
				};

				port@1 {
					reg = <1>;
					color0_out: endpoint {
						remote-endpoint = <&dither0_in>;
					};
				};
			};
		};

		ccorr0: ccorr@1400b000 {
			compatible = "mediatek,mt6789-disp-ccorr", "mediatek,mt8183-disp-ccorr";
			reg = <0 0x1400b000 0 0x1000>;
			interrupts = <GIC_SPI 292 IRQ_TYPE_LEVEL_HIGH &ppi_cluster0>;
			power-domains = <&spm MT6789_POWER_DOMAIN_DISP>;
			clocks = <&mmsys CLK_MM_DISP_CCORR0>;
			mediatek,gce-client-reg = <&gce0 SUBSYS_1400XXXX 0xb000 0x1000>;
		};

		aal0: aal@1400c000 {
			compatible = "mediatek,mt6789-disp-aal", "mediatek,mt8183-disp-aal";
			reg = <0 0x1400c000 0 0x1000>;
			interrupts = <GIC_SPI 294 IRQ_TYPE_LEVEL_HIGH &ppi_cluster0>;
			power-domains = <&spm MT6789_POWER_DOMAIN_DISP>;
			clocks = <&mmsys CLK_MM_DISP_AAL0>;
			mediatek,gce-client-reg = <&gce0 SUBSYS_1400XXXX 0xc000 0x1000>;
		};

		gamma0: gamma@1400d000 {
			compatible = "mediatek,mt6789-disp-gamma", "mediatek,mt8195-disp-gamma";
			reg = <0 0x1400d000 0 0x1000>;
			interrupts = <GIC_SPI 295 IRQ_TYPE_LEVEL_HIGH &ppi_cluster0>;
			power-domains = <&spm MT6789_POWER_DOMAIN_DISP>;
			clocks = <&mmsys CLK_MM_DISP_GAMMA0>;
			mediatek,gce-client-reg = <&gce0 SUBSYS_1400XXXX 0xd000 0x1000>;
		};

		postmask0: postmask@1400e000 {
			compatible = "mediatek,mt6789-disp-postmask";
			reg = <0 0x1400e000 0 0x1000>;
			interrupts = <GIC_SPI 296 IRQ_TYPE_LEVEL_HIGH &ppi_cluster0>;
			power-domains = <&spm MT6789_POWER_DOMAIN_DISP>;
			clocks = <&mmsys CLK_MM_DISP_POSTMASK0>;
			/*iommus = <&iommu0 M4U_PORT_L0_DISP_POSTMASK0>;*/
			mediatek,gce-client-reg = <&gce0 SUBSYS_1400XXXX 0xe000 0x1000>;
		};

		dither0: dither@14012000 {
			compatible = "mediatek,mt6789-disp-dither";
			reg = <0 0x1400f000 0 0x1000>;
			interrupts = <GIC_SPI 297 IRQ_TYPE_LEVEL_HIGH &ppi_cluster0>;
			power-domains = <&spm MT6789_POWER_DOMAIN_DISP>;
			clocks = <&mmsys CLK_MM_DISP_DITHER0>;
			mediatek,gce-client-reg = <&gce0 SUBSYS_1400XXXX 0xf000 0x1000>;

			ports {
				#address-cells = <1>;
				#size-cells = <0>;

				port@0 {
					reg = <0>;
					dither0_in: endpoint {
						remote-endpoint = <&color0_out>;
					};
				};

				port@1 {
					reg = <1>;
					dither0_out: endpoint {
						remote-endpoint = <&dsc0_in>;
					};
				};
			};
		};

		usb2: usb@11200000 {
			compatible = "mediatek,mt6789-musb",
			             "mediatek,mtk-musb";
			reg = <0 0x11200000 0 0x10000>;

			status = "disabled";

			interrupts = <GIC_SPI 128 IRQ_TYPE_LEVEL_HIGH &ppi_cluster0>;
			interrupt-names = "mc";

			clocks = <&infracfg_ao CLK_IFRAO_SSUSB>,
			         <&topckgen CLK_TOP_USB_TOP_SEL>,
			         <&apmixedsys CLK_APMIXED_USBPLL>;
			clock-names = "main", "mcu", "univpll";

			phys = <&u2port0 PHY_TYPE_USB2>;
		};

		u2phy: t-phy@11f40000 {
			compatible = "mediatek,mt6789-tphy",
			             "mediatek,generic-tphy-v2";
			#address-cells = <1>;
			#size-cells = <1>;
			ranges = <0 0 0x11f40000 0x1000>;

			u2port0: usb-phy@0 {
				reg = <0x0 0x700>;
				clocks = <&clk26m>;
				clock-names = "ref";
				#phy-cells = <1>;
				mediatek,eye-src = <4>;
				mediatek,eye-vrt = <4>;
				mediatek,eye-term = <4>;
				mediatek,discth = <7>;
			};
		};

		pio: pinctrl@10005000 {
			compatible = "mediatek,mt6789-pinctrl";
			reg = <0 0x10005000 0 0x1000>,
			      <0 0x11c30000 0 0x1000>,
			      <0 0x11d10000 0 0x1000>,
			      <0 0x11d40000 0 0x1000>,
			      <0 0x11e20000 0 0x1000>,
			      <0 0x11e60000 0 0x1000>,
			      <0 0x11ea0000 0 0x1000>,
			      <0 0x1000b000 0 0x1000>;
			reg-names = "base", "rb",  "bm", "br", "lm", "bl",
				    "rt", "eint";
			gpio-controller;
			#gpio-cells = <2>;
			gpio-ranges = <&pio 0 0 188>;
			interrupt-controller;
			interrupts = <GIC_SPI 244 IRQ_TYPE_LEVEL_HIGH &ppi_cluster0>;
			#interrupt-cells = <2>;
		};

		pwm0: pwm@10048000 {
			compatible = "mediatek,mt6789-pwm";
			reg = <0 0x10048000 0 0x1000>;
			interrupts = <GIC_SPI 242 IRQ_TYPE_LEVEL_HIGH &ppi_cluster0>;
			#pwm-cells = <2>;
			clocks = <&topckgen CLK_TOP_PWM_SEL>,
				 <&infracfg_ao CLK_IFRAO_PWM>,
				 <&infracfg_ao CLK_IFRAO_PWM1>,
				 <&infracfg_ao CLK_IFRAO_PWM2>,
				 <&infracfg_ao CLK_IFRAO_PWM3>,
				 <&infracfg_ao CLK_IFRAO_PWM4>;
			clock-names = "top", "main", "pwm1", "pwm2", "pwm3", "pwm4";
		};

		mmc0: mmc@11230000 {
			compatible = "mediatek,mt6789-mmc",
			             "mediatek,mt8183-mmc";
			reg = <0 0x11230000 0 0x10000>,
			      <0 0x11f50000 0 0x1000>;

			interrupts = <GIC_SPI 131 IRQ_TYPE_LEVEL_HIGH &ppi_cluster0>;

			clocks = <&topckgen CLK_TOP_MSDC50_0_SEL>,
			         <&infracfg_ao CLK_IFRAO_MSDC0>,
			         <&infracfg_ao CLK_IFRAO_MSDC0_SRC>;

			clock-names = "source", "hclk", "source_cg";

			status = "disabled";
		};

		mmc1: mmc@11240000 {
			compatible = "mediatek,mt6789-mmc",
			             "mediatek,mt8183-mmc";
			reg = <0 0x11240000 0 0x1000>,
			      <0 0x11ef0000 0 0x1000>;

			interrupts = <GIC_SPI 135 IRQ_TYPE_LEVEL_HIGH &ppi_cluster0>;

			clocks = <&topckgen CLK_TOP_MSDC30_1_SEL>,
			         <&infracfg_ao CLK_IFRAO_MSDC1>,
			         <&infracfg_ao CLK_IFRAO_MSDC1_SRC>;
			clock-names = "source", "hclk", "source_cg";

			status = "disabled";
		};

		pwrap: pmic-wrapper@10026000 {
			compatible = "mediatek,mt6789-pwrap", "syscon";
			reg = <0 0x10026000 0 0x1000>;
			reg-names = "pwrap";
			interrupts = <GIC_SPI 252 IRQ_TYPE_LEVEL_HIGH &ppi_cluster0>;
			clocks = <&infracfg_ao CLK_IFRAO_PMIC_AP>,
			         <&infracfg_ao CLK_IFRAO_PMIC_TMR>;
			assigned-clocks = <&topckgen CLK_TOP_PWRAP_ULPOSC_SEL>;
			assigned-clock-parents = <&topckgen CLK_TOP_OSC_D10>;
		};

		ufsphy: ufs-phy@11fa0000 {
			compatible = "mediatek,mt6789-ufsphy",
			             "mediatek,mt8183-ufsphy";
			reg = <0 0x01fa0000 0 0xc000>;
			clocks = <&infracfg_ao CLK_IFRAO_UNIPRO_SYSCLK>,
			         <&infracfg_ao CLK_IFRAO_UFS_SAP_BCLK>;
			clock-names = "unipro", "mp";
			#phy-cells = <0>;

			status = "disabled";
		};

		ufs: ufs@11270000 {
			compatible = "mediatek,mt6789-ufshci",
			             "mediatek,mt8183-ufshci";
			reg = <0 0x11270000 0 0x2300>;
			interrupts = <GIC_SPI 137 IRQ_TYPE_LEVEL_HIGH &ppi_cluster0>;
			phys = <&ufsphy>;

			status = "disabled";

			clocks = <&infracfg_ao CLK_IFRAO_UFS>,
			         <&topckgen CLK_TOP_UFS_SEL>;
			clock-names = "ufs", "ufs_sel";
			freq-table-hz = <0 0>, <0 0>;

			resets = <&infracfg_ao MT6789_INFRA_RST1_UFSHCI_SWRST>,
			         <&infracfg_ao MT6789_INFRA_RST2_UNIPRO_SWRST>,
			         <&infracfg_ao MT6789_INFRA_RST3_UFS_CRYPTO_SWRST>;
			reset-names = "hci_rst", "unipro_rst", "crypto_rst";

			mediatek,ufs-disable-mcq;
			mediatek,ufs-broken-vcc;
		};

		disp_pwm0: pwm@1100e000 {
			compatible = "mediatek,mt6789-disp-pwm";
			reg = <0 0x1100e000 0 0x1000>;
			interrupts = <GIC_SPI 203 IRQ_TYPE_LEVEL_HIGH &ppi_cluster0>;
			#pwm-cells = <2>;
			clocks = <&infracfg_ao CLK_IFRAO_DISP_PWM>,
			         <&topckgen CLK_TOP_DISP_PWM_SEL>;
			clock-names = "main", "mm";
		};

		apdma: dma-controller@10217800 {
			compatible = "mediatek,mt6789-uart-dma",
			             "mediatek,mt6577-uart-dma";
			reg = <0 0x10217800 0 0x80>,
			      <0 0x10217880 0 0x80>,
			      <0 0x10217900 0 0x80>,
			      <0 0x10217980 0 0x80>;
			interrupts = <GIC_SPI 178 IRQ_TYPE_LEVEL_HIGH &ppi_cluster0>,
			             <GIC_SPI 179 IRQ_TYPE_LEVEL_HIGH &ppi_cluster0>,
			             <GIC_SPI 180 IRQ_TYPE_LEVEL_HIGH &ppi_cluster0>,
			             <GIC_SPI 181 IRQ_TYPE_LEVEL_HIGH &ppi_cluster0>;
			dma-requests = <4>;
			clocks = <&infracfg_ao CLK_IFRAO_AP_DMA>;
			clock-names = "apdma";
			#dma-cells = <1>;
		};

		uart0: serial@11002000 {
			compatible = "mediatek,mt6789-uart",
			             "mediatek,mt6577-uart";
			reg = <0 0x11002000 0 0x1000>;
			interrupts = <GIC_SPI 141 IRQ_TYPE_LEVEL_HIGH &ppi_cluster0>;
			clocks = <&clk26m>, <&infracfg_ao CLK_IFRAO_UART0>;
			clock-names = "baud", "bus";
			dmas = <&apdma 0 &apdma 1>;
			dma-names = "tx", "rx";
			status = "disabled";
