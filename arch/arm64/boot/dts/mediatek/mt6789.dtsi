		gce0: mailbox@10228000 {
			compatible = "mediatek,mt6789-gce";
			reg = <0 0x10228000 0 0x4000>;
			interrupts = <GIC_SPI 235 IRQ_TYPE_LEVEL_HIGH &ppi_cluster0>;
			#mbox-cells = <2>;
			clocks = <&infracfg_ao CLK_IFRAO_GCE>;
			clock-names = "gce";
		};

		scp: scp@10500000 {
			compatible = "mediatek,mt6789-scp",
