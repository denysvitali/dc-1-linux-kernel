# --- Audio (MT6789 AFE + MT6366/MT6358 codec + RT9101 ext amp) ---
CONFIG_SOUND=y
CONFIG_SND=y
# Without dynamic minors ALSA hands out static device minor numbers,
# SNDRV_MINOR(card, type + dev) = (card << 5) | (type + dev), which gives each
# card a 32-minor window with PCM playback at 16-23 -- a hard ceiling of eight
# PCM devices per card. This card has thirty: the machine driver declares 30
# front-end (.dynamic) links plus 16 back-end (.no_pcm) ones, which is the 46
# DAIs the AFE reports. The ninth front-end lands on minor 24, which is already
# SNDRV_MINOR_PCM_CAPTURE for device 0, so snd_register_device() returns -EBUSY
# and snd_card_register() fails the whole card with "ASoC: failed to register
# soundcard -16" -- observed on hardware 2026-08-17, after the power-domain,
# clock, component-registration and VIBR of_node fixes had got the machine
# driver all the way to card registration. Nothing in the audio path is wrong
# at that point; the card is simply larger than static minors can express.
CONFIG_SND_DYNAMIC_MINORS=y
CONFIG_SND_SOC=y
CONFIG_SND_SOC_MEDIATEK=y
CONFIG_SND_SOC_MT6789=y
CONFIG_SND_SOC_MT6789_MT6366=y
CONFIG_COMMON_CLK_MT6789_AUDIOSYS=y

